# Скопіюйте в .env і підвантажте: set -a; source .env; set +a
# Секрети (пароль брокера) - лише тут або в змінних середовища, не в коді й не в темах.
PZIR_BROKER_HOST=127.0.0.1
PZIR_BROKER_PORT=1883
PZIR_BROKER_USER=
PZIR_BROKER_PASSWORD=
PZIR_DEVICE_ID=class-20
PZIR_DB=co2vent.db
PZIR_AGENT_DB=agent-state.db
PZIR_API_HOST=127.0.0.1
PZIR_API_PORT=8000
# 1 - реальний час (3 хв утримання); 10 - демонстрація в 10 разів швидше
PZIR_TIME_SCALE=1
